# ==============================================================================
# ShopPilot AI — Environment Configuration Template
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="ShopPilot AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./shoppilot.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/shoppilot"

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# If left empty, ShopPilot operates seamlessly in deterministic fallback mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PayPal Developer Sandbox Configuration
# Obtain test credentials from PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="your_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret_here"
# Currency Settings
DEFAULT_CURRENCY="USD"
INR_TO_USD_RATE="0.012"

